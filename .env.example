# LLM (published board uses gpt-5.6-sol).
OPENAI_API_KEY=
# Benchmark fork: run the same agent loop on Claude instead. Set LLM_PROVIDER=anthropic
# explicitly; the OpenAI key may stay in this file and is then ignored.
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_THINKING=adaptive      # adaptive (default; effort-steered) | budget (fixed tokens) | off
# Or Azure Foundry OpenAI-v1:
# AZURE_OPENAI_NEXTGEN_DEPLOYMENT_URL=
# AZURE_OPENAI_NEXTGEN_DEPLOYMENT_KEY=

# Search / fetch vendors — only the ones you run.
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
LINKUP_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YDC_API_KEY=
# YOU_API_KEY=   # alias for YDC_API_KEY
TINYFISH_API_KEY=
PERPLEXITY_API_KEY=

# Optional tracing.
BRAINTRUST_API_KEY=

# Ticket tree: .../web-search/coding/tasks/catalog.json
# DATASETS_ROOT=

# Nimble Search / Agents
NIMBLE_API_KEY=

# Jevlin (benchmark fork; see scripts/coding_search/jevlin.py).
JEVLIN_API_KEY=
JEVLIN_API_URL=https://api.jevlin.ai
# Pinned provider set for jevlin_fanout_raw / jevlin_fanout_merged (required for those arms).
JEVLIN_PROVIDERS=
# Provider for jevlin_single (default exa).
JEVLIN_SINGLE_PROVIDER=exa
# The jevlin executable for jevlin_cli, and its benchmark-only config (experiments/jevlin-cli/setup.sh).
# JEVLIN_CLI_CONFIG, not JEVLIN_CONFIG: a JEVLIN_CONFIG exported by your shell would win over this file.
JEVLIN_BIN=jevlin
JEVLIN_CLI_CONFIG=
JEVLIN_TIMEOUT_S=45
